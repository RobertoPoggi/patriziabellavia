{
  "name": "patriziabellavia",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler pages dev dist --d1=DB --local --ip 0.0.0.0 --port 3000",
    "build": "vite build && node scripts/post-build.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name patriziabellavia",
    "db:create": "wrangler d1 create patriziabellavia-db",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB",
    "db:seed:local": "wrangler d1 execute DB --local --file=./migrations/seed.sql",
    "db:reset": "rm -rf .wrangler/state && npm run db:migrate:local && npm run db:seed:local",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.12.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "wrangler": "^4.110.0"
  }
}
